NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical production origin (no trailing slash). Drives sitemap URLs,
# canonical tags, and absolute OG image URLs. Must be the single host you
# want indexed — e.g. https://www.thetruenorthframes.com
NEXT_PUBLIC_APP_URL=https://www.thetruenorthframes.com
